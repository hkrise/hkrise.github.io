---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  accent: number;
}

const { project, index, accent } = Astro.props;
const reverse = index % 2 === 1;
---

<a
  class:list={['project-row', { reverse }]}
  href={project.href}
  target="_blank"
  rel="noopener noreferrer"
  style={`--row-accent: var(--accent-${accent})`}
  data-reveal
>
  <div class="media">
    <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
  </div>
  <div class="copy">
    <p class="eyebrow">Open site</p>
    <h3>{project.title}</h3>
    <p class="pitch">{project.pitch}</p>
    <ul class="tags" aria-label="Topics">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <span class="cta-label">Open site <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .project-row {
    --row-accent: var(--accent-0);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    position: relative;
    isolation: isolate;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .project-row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--row-accent);
    z-index: 2;
  }

  .project-row:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(11, 42, 58, 0.18);
  }

  .project-row.reverse .media {
    order: 2;
  }

  .project-row.reverse .copy {
    order: 1;
  }

  .media {
    min-height: 14rem;
    background: var(--color-deep);
    order: 1;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease);
  }

  .project-row:hover .media img {
    transform: scale(1.03);
  }

  .copy {
    padding: clamp(1.4rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    order: 2;
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--row-accent);
  }

  h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.6vw, 2rem);
    color: var(--color-deep);
    line-height: 1.15;
  }

  .pitch {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .tags li {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-sea);
    background: rgba(26, 77, 99, 0.08);
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
  }

  .cta-label {
    margin-top: var(--space-5);
    font-weight: 700;
    color: var(--row-accent);
  }

  @media (max-width: 820px) {
    .project-row {
      grid-template-columns: 1fr;
    }

    .project-row.reverse .media,
    .media {
      order: 1;
    }

    .project-row.reverse .copy,
    .copy {
      order: 2;
    }

    .media {
      min-height: 12rem;
      max-height: 16rem;
    }
  }
</style>
