---
import { accentIndex, projects } from '../data/projects';
import ProjectRow from './ProjectRow.astro';
---

<section class="projects" id="projects" aria-labelledby="projects-heading">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 id="projects-heading">Projects</h2>
      <p>Choose a project from the list below.</p>
    </header>
    <div class="list">
      {
        projects.map((project, index) => (
          <ProjectRow project={project} index={index} accent={accentIndex(project, index)} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: var(--space-8) 0;
  }

  .section-head {
    max-width: 38rem;
    margin-bottom: var(--space-6);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    color: var(--color-deep);
  }

  .section-head p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .list {
    display: grid;
    gap: var(--space-5);
  }
</style>
