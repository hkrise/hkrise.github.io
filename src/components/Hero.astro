---
---

<section class="hero" id="top" aria-label="HKRISE introduction">
  <div class="hero-media" aria-hidden="true">
    <img class="hero-image" src="/hero.jpg" alt="" fetchpriority="high" />
    <div class="hero-scrim"></div>
  </div>
  <div class="container hero-copy">
    <p class="brand-mark">HKRISE</p>
    <h1>
      <span class="h1-lead">Hong Kong rocky intertidal ecology,</span><br />
      open to explore
    </h1>
    <p class="support">
      A family of interactive sites for the biodiversity and physical environments of Hong Kong’s
      hard rock coastal environments.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="#projects">Explore projects</a>
      <a
        class="btn btn-secondary"
        href="https://www.tidehku.com/"
        target="_blank"
        rel="noopener noreferrer">About TIDE, HKU</a
      >
      <a
        class="btn btn-secondary"
        href="https://hkcoastalecology.wordpress.com/"
        target="_blank"
        rel="noopener noreferrer">About TideChaser, LU</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--nav-height));
    display: grid;
    align-items: end;
    color: var(--color-white);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    animation: kenburns 28s var(--ease) infinite alternate;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 42, 58, 0.28) 0%, rgba(11, 42, 58, 0.55) 45%, var(--color-scrim) 100%),
      linear-gradient(90deg, rgba(11, 42, 58, 0.45) 0%, transparent 55%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, var(--max-width));
    margin-inline: auto;
    padding: var(--space-8) 0 var(--space-7);
    max-width: 44rem;
    justify-self: start;
    margin-left: max(1rem, calc((100vw - var(--max-width)) / 2));
    animation: rise-in 0.9s var(--ease) both;
  }

  @media (max-width: 72rem) {
    .hero-copy {
      margin-left: 1rem;
      margin-right: 1rem;
      width: auto;
      max-width: 44rem;
    }
  }

  .brand-mark {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 4.6rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3.4vw, 2.35rem);
    font-weight: 500;
    line-height: 1.25;
    max-width: none;
  }

  .h1-lead {
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .h1-lead {
      white-space: normal;
    }
  }

  .support {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.92);
    max-width: 38rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-5);
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes kenburns {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.12) translate3d(-1.5%, -1%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      animation: none;
      transform: none;
    }

    .hero-copy {
      animation: none;
    }
  }
</style>
